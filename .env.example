# Session Manager configuration — template
# Copy to .env and fill in real values; .env itself should never be committed.
#   cp .env.example .env

# --- Archive storage backend -----------------------------------------
# Leave unset for auto (MinIO if configured+reachable, else local disk).
# Set to "local" to force local disk, or "minio" to force MinIO and fail
# loudly instead of silently falling back if it can't connect.
PLAYSCAN_ARCHIVE_BACKEND=

# --- MinIO (recommended for anything beyond a single local machine) --
PLAYSCAN_MINIO_ENDPOINT=localhost:9000
PLAYSCAN_MINIO_ACCESS_KEY=
PLAYSCAN_MINIO_SECRET_KEY=
PLAYSCAN_MINIO_BUCKET=playscan-sessions
PLAYSCAN_MINIO_USE_SSL=false

# --- Local disk fallback ----------------------------------------------
PLAYSCAN_ARCHIVES_DIR=./profiles

# --- Session Establishment Protocol (SEP) encryption -------------------
# Base64-encoded 32 bytes (AES-256-GCM). Generate your own:
#   openssl rand -base64 32
PLAYSCAN_SEP_ENCRYPTION_KEY=
